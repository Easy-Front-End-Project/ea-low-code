# MySQL Configuration
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=nestjs_db
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password

# NestJS Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=nestjs_db

# NestJS Server Configuration
PORT=3000

# CORS Configuration - 允许的源，多个用逗号分隔
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters

# SMTP Configuration (Optional - for email verification)
# If not configured, email verification codes will be logged to console
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
