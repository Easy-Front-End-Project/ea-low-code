{
  "name": "ea-low-code",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:web": "npm run dev -w apps/web",
    "dev:server": "npm run dev -w apps/server",
    "dev:all": "run-p dev:web dev:server",
    "build": "npm run build -w apps/web",
    "build:web": "npm run build -w apps/web",
    "build:server": "npm run build -w apps/server",
    "lint": "npm run lint -w apps/web",
    "format": "npm run format -w apps/web",
    "deploy": "npm run deploy -w apps/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0"
  }
}
